# Pars Linux APT Deposu Webhook Yapılandırması
# Bu dosyayı .webhook.env olarak kopyalayıp değerlerinizi girebilirsiniz.

# 1. Discord Webhook Entegrasyonu
# Discord kanal ayarları -> Entegrasyonlar -> Webhook oluştur
DISCORD_WEBHOOK_URL=""

# 2. Telegram Bot Entegrasyonu
# BotFather'dan alınan bot token ve grubunuzun/kanalınızın Chat ID'si
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 3. Slack Webhook Entegrasyonu
# Slack App -> Incoming Webhooks
SLACK_WEBHOOK_URL=""
