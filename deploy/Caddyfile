# ==============================================================================
# Caddyfile - Otomatik HTTPS / SSL Ters Proxy Konfigürasyonu
# ==============================================================================
# Caddy, Let's Encrypt SSL sertifikasını tamamen otomatik olarak alır ve yeniler.
#
# Kullanım:
#   caddy run --config deploy/Caddyfile
# ==============================================================================

depo.sirketiniz.com {
    # Ters proxy ile arka plandaki Web Dashboard ve APT sunucusuna yönlendir
    reverse_proxy 127.0.0.1:8080

    # Meta veriler için önbelleği devre dışı bırak
    @metadata path */Release */InRelease */Packages
    header @metadata Cache-Control "no-cache, no-store, must-revalidate"

    # .deb paketleri için agresif önbellek
    @packages path *.deb
    header @packages Cache-Control "public, max-age=31536000, immutable"

    # Sıkıştırma
    encode zstd gzip
}
